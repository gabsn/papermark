# Self-hosted Papermark (selfhost/README.md). Copy to .env, fill the blanks.
PAPERMARK_SELFHOST=1
PAPERMARK_DATA=./.data
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_HOST=localhost
# Set by selfhost/start.mjs from the embedded Postgres; only override to use another server.
POSTGRES_PRISMA_URL=postgresql://papermark:papermark@127.0.0.1:54329/papermark
POSTGRES_PRISMA_URL_NON_POOLING=postgresql://papermark:papermark@127.0.0.1:54329/papermark
# Documents are stored on disk through the S3 replacement.
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
NEXT_PRIVATE_UPLOAD_BUCKET=papermark
NEXT_PRIVATE_UPLOAD_REGION=local
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST=localhost
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=
NEXT_PRIVATE_VERIFICATION_SECRET=
INTERNAL_API_KEY=
REVALIDATE_TOKEN=
# Emails through Amazon SES (resend replacement).
SES_REGION=eu-west-3
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
EMAIL_FROM="Papermark <deck@email.focustree.app>"
