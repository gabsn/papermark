# Self-hosted Papermark (selfhost/README.md). Copy to .env, fill the blanks.
PAPERMARK_SELFHOST=1
PAPERMARK_DATA=./.data
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_HOST=localhost
# Set by selfhost/start.mjs from the embedded Postgres; only override to use another server.
POSTGRES_PRISMA_URL=postgresql://papermark:papermark@127.0.0.1:54329/papermark
POSTGRES_PRISMA_URL_NON_POOLING=postgresql://papermark:papermark@127.0.0.1:54329/papermark
# Documents are stored on disk through the S3 replacement.
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
NEXT_PRIVATE_UPLOAD_BUCKET=papermark
NEXT_PRIVATE_UPLOAD_REGION=local
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST=localhost
# Required by ee/features/storage/config.ts; the filesystem store ignores them.
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=local
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=local
NEXT_PRIVATE_ARCHIVE_BUCKET=papermark-archive
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=
NEXT_PRIVATE_VERIFICATION_SECRET=
INTERNAL_API_KEY=
REVALIDATE_TOKEN=
# Emails through Amazon SES (resend replacement, selfhost/shims/resend.ts).
# EMAIL_TRANSPORT: ses | outbox. Unset: ses when both SES keys are set, else outbox
# (emails printed to stdout and written to $PAPERMARK_DATA/outbox, login link included).
# EMAIL_TRANSPORT=ses with empty keys uses the default AWS credential chain.
EMAIL_TRANSPORT=
SES_REGION=eu-west-3
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
EMAIL_FROM="Papermark <deck@email.focustree.app>"
# Local feature flags and blocklists (selfhost/shims/vercel-edge-config.ts); any
# non-empty value turns them on. Overrides: $PAPERMARK_DATA/edge-config.json.
EDGE_CONFIG=selfhost
# Billing is off, but ee/stripe builds its clients at import time (sign-in imports it)
# and the Stripe SDK throws on an empty key. Placeholders, never called.
STRIPE_SECRET_KEY=sk_test_selfhost_disabled
STRIPE_SECRET_KEY_OLD=sk_test_selfhost_disabled
# Optional sign-in methods, offered only when set: GOOGLE_CLIENT_ID/SECRET,
# LINKEDIN_CLIENT_ID/SECRET, HANKO_API_KEY + NEXT_PUBLIC_HANKO_TENANT_ID (passkeys).
# Incoming webhooks host (unused when self-hosted; next.config needs a value).
NEXT_PUBLIC_WEBHOOK_BASE_HOST=webhooks.invalid
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://webhooks.invalid
